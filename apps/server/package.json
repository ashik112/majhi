{
  "name": "@majhi/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts src/cli.ts --bundle --platform=node --format=esm --target=node22 --external:node-pty --external:better-sqlite3 --outdir=dist --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@majhi/acp": "workspace:*",
    "@majhi/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.31.0",
    "age-encryption": "0.3.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "node-pty": "1.1.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
