{
  "name": "@majhi/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/majhi-host.mjs",
    "ssh:dry-run": "tsx src/sshDryRun.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@majhi/shared": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
