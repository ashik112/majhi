  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The filled action, in the pickable accent with a soft halo.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>New task</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 14px;border:0;border-radius:8px;background:var(--c-accent);color:var(--c-accent-ink);font:600 13px/20px \"IBM Plex Sans\",system-ui,sans-serif;box-shadow:0 6px 18px -8px var(--c-accent);cursor:pointer;transition:background-color .15s}.ds-btn-primary:hover{background:var(--c-accent-hover)}.ds-btn-primary:active{background:var(--c-accent-press)}.ds-btn-primary:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "The default button: raised tint with a control hairline.",
      "html": "<button class=\"ds-btn-secondary\">Open room</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;height:34px;padding:0 12px;border:1px solid var(--c-line-control);border-radius:8px;background:var(--c-raised);color:var(--c-fg);font:500 13px/20px \"IBM Plex Sans\",system-ui,sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-btn-secondary:hover{border-color:var(--c-line-hover);background:var(--c-selected)}.ds-btn-secondary:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-emphasis actions in bars and headers.",
      "html": "<button class=\"ds-btn-ghost\">Cancel</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;height:34px;padding:0 12px;border:0;border-radius:8px;background:transparent;color:var(--c-fg-muted);font:500 13px/20px \"IBM Plex Sans\",system-ui,sans-serif;cursor:pointer;transition:background-color .15s,color .15s}.ds-btn-ghost:hover{background:var(--c-raised);color:var(--c-fg)}.ds-btn-ghost:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Field well with a control hairline; focus turns the border accent.",
      "html": "<input class=\"ds-input\" placeholder=\"Search tasks\" />",
      "css": ".ds-input{height:34px;width:240px;padding:0 12px;border:1px solid var(--c-line-control);border-radius:8px;background:var(--c-field);color:var(--c-fg);caret-color:var(--c-accent);font:400 13px/20px \"IBM Plex Sans\",system-ui,sans-serif;transition:border-color .15s}.ds-input::placeholder{color:var(--c-fg-faint)}.ds-input:hover{border-color:var(--c-line-hover)}.ds-input:focus-visible{outline:none;border-color:var(--c-accent)}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item-selected",
      "description": "32px rows; the selected row carries a lit accent hairline on its left edge.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item ds-on\" href=\"#\">Board</a><a class=\"ds-nav-item\" href=\"#\">Agents<span class=\"ds-count\">9</span></a><a class=\"ds-nav-item\" href=\"#\">Accounts<span class=\"ds-count\">6</span></a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:1px;width:204px}.ds-nav-item{position:relative;display:flex;align-items:center;height:32px;padding:0 10px;border-radius:8px;color:var(--c-fg-muted);font:500 14px/22px \"IBM Plex Sans\",system-ui,sans-serif;text-decoration:none;transition:background-color .15s,color .15s}.ds-nav-item:hover{background:var(--c-raised);color:var(--c-fg)}.ds-nav-item:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px}.ds-nav-item.ds-on{background:var(--c-selected);color:var(--c-fg)}.ds-nav-item.ds-on::before{content:\"\";position:absolute;top:8px;bottom:8px;left:0;width:1px;border-radius:9999px;background:var(--c-accent);box-shadow:0 0 6px var(--c-accent)}.ds-count{margin-left:auto;font:400 12px \"IBM Plex Mono\",monospace;font-variant-numeric:tabular-nums;color:var(--c-fg-faint)}"
    },
    {
      "name": "Choice Chip",
      "kind": "chip",
      "refersTo": "choice-chip-pressed",
      "description": "Form choices as toggle chips; pressed takes the accent wash.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">Acme</button><button class=\"ds-chip\" aria-pressed=\"false\">Globex</button></div>",
      "css": ".ds-chips{display:flex;gap:6px}.ds-chip{min-height:34px;padding:0 12px;border:1px solid var(--c-line-strong);border-radius:8px;background:var(--c-card);color:var(--c-fg-muted);font:400 12px/18px \"IBM Plex Sans\",system-ui,sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s}.ds-chip:hover{border-color:var(--c-line-hover);color:var(--c-fg)}.ds-chip[aria-pressed=\"true\"]{border-color:var(--c-accent-line);background:var(--c-accent-wash);color:var(--c-fg)}.ds-chip:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px}"
    },
    {
      "name": "Status Lamp",
      "kind": "custom",
      "refersTo": "lamp",
      "description": "Five states, one colour each, always with the word beside it.",
      "html": "<div class=\"ds-lamps\"><span><i class=\"ds-lamp ds-working\"></i>Working</span><span><i class=\"ds-lamp ds-needs\"></i>Needs you</span><span><i class=\"ds-lamp ds-paused\"></i>Paused</span><span><i class=\"ds-lamp ds-done\"></i>Done</span><span><i class=\"ds-lamp ds-idle\"></i>Idle</span></div>",
      "css": ".ds-lamps{display:flex;gap:16px;font:400 12px/18px \"IBM Plex Sans\",system-ui,sans-serif;color:var(--c-fg-soft)}.ds-lamps span{display:inline-flex;align-items:center;gap:6px}.ds-lamp{display:inline-block;width:8px;height:8px;border-radius:9999px;background:currentColor}.ds-working{color:var(--c-lamp-working);animation:ds-lamp 2.2s ease-in-out infinite}.ds-needs{color:var(--c-lamp-needs);box-shadow:0 0 0 3px color-mix(in oklab,currentColor 16%,transparent),0 0 9px color-mix(in oklab,currentColor 55%,transparent)}.ds-paused{color:var(--c-lamp-paused);box-shadow:0 0 0 3px color-mix(in oklab,currentColor 16%,transparent),0 0 9px color-mix(in oklab,currentColor 55%,transparent)}.ds-done{color:var(--c-lamp-done)}.ds-idle{color:var(--c-lamp-idle);background:transparent;border:1.5px solid currentColor;box-sizing:border-box}@keyframes ds-lamp{0%,100%{box-shadow:0 0 0 0 color-mix(in oklab,currentColor 45%,transparent),0 0 8px 0 color-mix(in oklab,currentColor 55%,transparent)}50%{box-shadow:0 0 0 4px transparent,0 0 12px 1px color-mix(in oklab,currentColor 70%,transparent)}}"
    },
    {
      "name": "Task Card",
      "kind": "card",
      "refersTo": "task-card",
      "description": "A task on the board; lit states carry the lamp in the frame.",
      "html": "<article class=\"ds-card ds-lit-needs\"><div class=\"ds-card-top\"><i class=\"ds-card-lamp\"></i><span class=\"ds-id\">ACME-19</span></div><a class=\"ds-card-title\" href=\"#\">Split the importer into two steps</a><span class=\"ds-card-line\">Your turn: reply in the room</span><span class=\"ds-bar\"><span style=\"width:20%\"></span></span></article>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:8px;width:320px;padding:12px;border:1px solid var(--c-glass-line);border-radius:12px;background:var(--c-card);color:var(--c-fg);box-shadow:var(--c-shadow-glass);backdrop-filter:blur(12px);font-family:\"IBM Plex Sans\",system-ui,sans-serif;transition:transform .15s,border-color .15s,box-shadow .15s}.ds-card:hover{transform:translateY(-1px);border-color:var(--c-line-hover);box-shadow:var(--c-shadow-pop)}.ds-card:focus-within{outline:2px solid var(--c-accent);outline-offset:2px}.ds-lit-needs{border-color:color-mix(in oklab,var(--c-lamp-needs) 35%,transparent);background-image:linear-gradient(180deg,color-mix(in oklab,var(--c-lamp-needs) 8%,transparent),transparent 60%)}.ds-card-top{display:flex;align-items:center;gap:8px;height:20px}.ds-card-lamp{width:8px;height:8px;border-radius:9999px;background:var(--c-lamp-needs);box-shadow:0 0 0 3px color-mix(in oklab,var(--c-lamp-needs) 16%,transparent),0 0 9px color-mix(in oklab,var(--c-lamp-needs) 55%,transparent)}.ds-id{font:400 11px/16px \"IBM Plex Mono\",monospace;color:var(--c-fg-muted)}.ds-card-title{font:500 14px/1.35 \"IBM Plex Sans\",system-ui,sans-serif;color:var(--c-fg);text-decoration:none;outline:none}.ds-card-line{font-size:12px;line-height:18px;color:var(--c-lamp-needs)}.ds-bar{display:block;height:3px;border-radius:9999px;background:var(--c-line-strong);overflow:hidden}.ds-bar span{display:block;height:100%;border-radius:9999px;background:var(--c-blue)}"
    },
    {
      "name": "Column Rail",
      "kind": "custom",
      "refersTo": "glass-panel",
      "description": "An empty column collapsed to a dashed rail with lamp, vertical name and count.",
      "html": "<section class=\"ds-rail\"><i></i><h2>Working</h2><span>0</span></section>",
      "css": ".ds-rail{display:flex;flex-direction:column;align-items:center;gap:12px;width:44px;height:240px;padding:14px 0;border:1px dashed var(--c-line-control);border-radius:14px;box-sizing:border-box}.ds-rail i{width:7px;height:7px;border-radius:9999px;background:var(--c-lamp-working);opacity:.35}.ds-rail h2{margin:0;writing-mode:vertical-rl;font:500 12px/18px \"IBM Plex Sans\",system-ui,sans-serif;color:var(--c-fg-soft)}.ds-rail span{font:400 12px \"IBM Plex Mono\",monospace;font-variant-numeric:tabular-nums;color:var(--c-fg-muted)}"
