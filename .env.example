# Copy to .env to change defaults. `make up` fills HOST_UID and HOST_GID for you.

# Port majhi listens on, on 127.0.0.1 only.
MAJHI_PORT=7070

# The SSH agent socket majhi uses for git over SSH. `make up` picks it per OS: on macOS the socket
# OrbStack and Docker Desktop forward from the Mac (an older SSH_AGENT_SOCK line still works there),
# on Linux and WSL2 the host helper's ~/.majhi/run/ssh-agent.sock. Set an absolute path, or off for none.
# MAJHI_SSH_AGENT=off

# PyTorch for Laya when `make up` gives it an NVIDIA GPU. The default, CUDA 13.0, needs a Turing (2018)
# or newer GPU and driver 580 or newer. For an older GPU or driver:
# MAJHI_LAYA_TORCH_INDEX=https://download.pytorch.org/whl/cu126

# File holding the age key that encrypts API keys in ~/.majhi/secrets.age. `make up` creates it (mode 600) when missing.
# Keep it outside ~/.majhi and back it up: without it, saved API keys cannot be read.
# Absolute path, no ~. Default: $HOME/.config/majhi/secrets.key
# MAJHI_SECRETS_KEY=/Users/you/.config/majhi/secrets.key
