# Copy to .env to change defaults. `make up` fills HOST_UID and HOST_GID for you.

# Port majhi listens on, on 127.0.0.1 only.
MAJHI_PORT=7070

# SSH agent socket forwarded from the host. OrbStack and Docker Desktop both use this path.
SSH_AGENT_SOCK=/run/host-services/ssh-auth.sock

# File holding the age key that encrypts API keys in ~/.majhi/secrets.age. `make up` creates it (mode 600) when missing.
# Keep it outside ~/.majhi and back it up: without it, saved API keys cannot be read.
# Absolute path, no ~. Default: $HOME/.config/majhi/secrets.key
# MAJHI_SECRETS_KEY=/Users/you/.config/majhi/secrets.key
